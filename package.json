{
  "name": "varcal",
  "description": "Módulo de variables calculadas",
  "version": "1.3.17",
  "author": "Codenautas <codenautas@googlegroups.com>",
  "contributors": [
    "Raquel N Salva <raquelzssalva@gmail.com>",
    "Eugenio Arosteguy <eugenio.arosteguy@gmail.com>",
    "Emilio Platzer <emilioplatzer@gmail.com>"
  ],
  "repository": "codenautas/varcal",
  "license": "MIT",
  "main": "dist/server/app-varcal.js",
  "types": "dist/server/app-varcal.d.ts",
  "files": [
    "dist",
    "install"
  ],
  "dependencies": {
    "expre-parser": "~0.2.1",
    "operativos": "^1.3.23",
    "last-agg": "^1.0.0"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/mocha": "^10.0.10",
    "mocha": "^11.1.0",
    "discrepances": "~0.2.8",
    "types.d.ts": "~0.6.22",
    "mixin-patch": "~0.4.1",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">= 14.0.0"
  },
  "scripts": {
    "prepare": "npm run build",
    "build": "tsc -p src/client && tsc -p src/server && mixin-patch",
    "watch:build": "tsc -p src/server --watch",
    "test": "tsc -p src/tests && mocha --reporter spec --bail --check-leaks compile-for-test/tests/*.js",
    "start": "node dist/server/server-varcal.js",
    "clink": "npm prune && npm i && npm run build && npm link operativos && npm run build"
  },
  "qa-control": {
    "package-version": "0.3.0",
    "coverage": 90,
    "run-in": "server",
    "stability": "extending",
    "type": "lib",
    "ecmaVersion": 6
  }
}
